node_modules
dist
.env
.env.local
.DS_Store

# Android Studio / IntelliJ project state — machine-local, not shared config.
android/.idea/

# Xcode Cloud workspace metadata — machine/account-local, not shared config.
ios/App/App.xcodeproj/xcshareddata/xcodecloud/

# Firebase CLI local cache + logs (firebase.json / .firebaserc are committed;
# these are machine-local and must not be). `firebase login` credentials live
# in ~/.config/configstore/firebase-tools.json, never in the repo.
.firebase/
firebase-debug.log
firestore-debug.log

# Planning notes live in the private igwheels/student-driver-log-notes repo
# instead — this repo is public (GitHub Free doesn't support Pages on a
# private repo), so this guards against ever re-adding it here.
roadmap.md

# Android release signing — never commit
android/keystore.properties
*.jks
*.keystore

# Signed/unsigned legal agreements — contains counterparties' contact info
# and signatures; this repo is public. Keep locally or in the private
# igwheels/student-driver-log-notes repo instead (see roadmap.md above).
docs/licenses/
