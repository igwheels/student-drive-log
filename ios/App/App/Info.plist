<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Student Drive Log</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<!--
	  Google Sign-In (via @capacitor-firebase/authentication) redirects back
	  into the app through this custom URL scheme once the user picks an
	  account — this is the REVERSED_CLIENT_ID from GoogleService-Info.plist
	  (that file itself lives only on each developer's machine, not in this
	  repo, so this value has to be hardcoded here instead of read from it).
	  Without it, Firebase's iOS SDK crashes at launch with
	  NSInvalidArgumentException: "Your app is missing support for the
	  following URL schemes: ...".
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.829898988631-11b1f4r6p7q73op0r6059n52nhmts9d7</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSFaceIDUsageDescription</key>
	<string>Student Drive Log can use Face ID to unlock the app instead of your password. This never replaces your account's password or changes who can sign in.</string>
	<!--
	  Required by App Store validation (ITMS-90683): the background-geolocation
	  plugin links location APIs that include "Always" authorization. The app
	  itself only requests "When In Use" (see below) and never asks for Always.
	-->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Student Drive Log uses your location only while you are timing a practice drive, including if you switch to another app during the drive, to measure the distance driven and draw the route map on the saved log. It does not track you when no drive is being timed. You can decline and enter mileage by hand.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Student Drive Log uses your location only while you are timing a practice drive, to measure the distance driven and draw the route map on the saved log. You can decline and enter mileage by hand.</string>
	<key>NSMotionUsageDescription</key>
	<string>Student Drive Log reads motion sensors only while you are timing a practice drive, to spot hard braking and harsh turns and give the supervising adult a heads-up. This data stays on your device. You can decline and still time drives normally.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!--
	  Lets a drive keep recording mileage and route while the app is
	  backgrounded (the supervisor switches to Maps, etc.). "When In Use" is
	  enough for this — iOS permits background location under it while this
	  mode is declared and the blue status-bar indicator is showing. No
	  "Always" authorization is requested; tracking still stops if the app is
	  fully closed. See docs/background-drive-tracking-spec.md.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
