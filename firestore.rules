// Firestore security rules for Student Drive Log.
//
// Deployed via the Firebase CLI (`npx firebase-tools deploy --only
// firestore:rules --project student-driver-log-b1924`; see the root
// README's Firestore section) — this file is the version-controlled
// source of truth for what should be live. Keep the two in sync: edit
// here, diff against what's deployed, then deploy.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // DEV-62: access is keyed off the stable uid a share has resolved to,
    // not off whichever address Firebase currently reports as
    // request.auth.token.email. Apple's Hide My Email can hand a shared
    // recipient a different relay address across sign-ins (or start
    // reporting a relay address for someone previously matched on their
    // real one), which broke sharedWithEmails matching outright — the
    // collection-group query returned nothing and they saw an empty
    // student list with no error.
    //
    // sharedWithUids is populated in one of two ways: at share time, if
    // the recipient already has an account (shareStudent's emailToUid
    // lookup), or the first time they sign in with the address they were
    // invited under (the self-resolve rule below, driven by the matching
    // client logic in src/context/AppContext.jsx). Once populated, access
    // no longer depends on email at all.
    function isSharedWithMe(studentData) {
      return request.auth.uid in studentData.get('sharedWithUids', []);
    }

    // ---------------------------------------------------------------------
    // emailPreferences/{email} -> { weeklyEmailOptOut, updatedAt }
    //
    // Reachable without a signed-in session on purpose: the unsubscribe link
    // in a progress email has to work for whoever received it, and the
    // recipient may not have an account at all.
    //
    // get() stays open for that. list() does NOT — the document IDs here are
    // email addresses, so an open list let anyone dump every address that has
    // ever set a preference. Nothing in the app lists this collection; both
    // callers read a single known doc (src/utils/emailPreferences.js).
    //
    // Writes are pinned to exactly the two fields the app writes, with the
    // right types, so this can't be used as free unauthenticated storage.
    // updatedAt is length-capped as well: the app writes an ISO timestamp
    // (24 chars, see src/utils/emailPreferences.js), and without a cap the
    // field would accept up to a megabyte of arbitrary data per document.
    // The cap bounds what one document can hold; it does not bound how many
    // documents an anonymous caller can create, which is the same gap the
    // note below describes and needs the same fix.
    //
    // Residual, accepted for now: anyone who knows an address can still
    // toggle that address's preference. Closing that needs a signed token in
    // the unsubscribe URL, which is a code change, not a rules change.
    //
    // Delete is narrower than write on purpose. Account deletion removes the
    // document so the address isn't left on file, but only the signed-in
    // owner of that address may do it — an open delete would let anyone clear
    // someone's opt-out and quietly resubscribe them.
    // ---------------------------------------------------------------------
    match /emailPreferences/{email} {
      allow get: if true;
      allow list: if false;
      allow create, update: if
        request.resource.data.keys().hasOnly(['weeklyEmailOptOut', 'updatedAt']) &&
        request.resource.data.weeklyEmailOptOut is bool &&
        request.resource.data.updatedAt is string &&
        request.resource.data.updatedAt.size() < 40;
      allow delete: if signedIn() && email == myEmail();
    }

    // ---------------------------------------------------------------------
    // studentDirectory/{sha256(email)}
    //   -> { studentId, ownerId, ownerName, firstName, lastName, email }
    //
    // Minimal cross-account record backing the "does a dashboard for this
    // email already exist?" check, so that lookup doesn't need read access to
    // the full student documents.
    //
    // create/update/delete are split apart deliberately. The previous single
    // `allow write: if signedIn() && request.resource.data.ownerId == request.auth.uid`
    // only inspected the INCOMING data, never the existing document — so any
    // signed-in user could overwrite anyone's directory entry by setting
    // ownerId to themselves, taking over the entry and redirecting future
    // access requests for that student to themselves. Update and delete now
    // check the stored owner as well.
    //
    // Documents are keyed by a SHA-256 of the student's email, so the
    // duplicate-email check is a direct read of one known document. That is
    // what lets `list` be denied: rules cannot inspect a query's filters, so
    // back when the check ran a where('email','==') query, permitting it meant
    // permitting the whole collection to be read out — any signed-in user
    // could enumerate every student's name and email.
    //
    // `get` stays open to signed-in users; finding an entry now requires
    // already knowing the address it was derived from.
    // ---------------------------------------------------------------------
    match /studentDirectory/{emailHash} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() &&
        resource.data.ownerId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // accessRequests/{requestId}
    //
    // One pending request per "let me see this student's dashboard" ask.
    // ownerId is verified rather than trusted from the client, so a request
    // can't be aimed at an account that doesn't actually own the student.
    // That check now reads the student document directly — proving the
    // student really does live under the claimed owner's account — instead
    // of going through studentDirectory, whose keys are no longer studentIds.
    // (get()/exists() inside rules are evaluated with full access, so this
    // works even though the requester can't read that student themselves.)
    //
    // The requester's identity was already pinned to their own uid/email,
    // which is what makes it safe for approveRequest() to grant access to
    // the address stored here; update stays closed so it can't be swapped
    // after the owner sees it.
    // ---------------------------------------------------------------------
    match /accessRequests/{requestId} {
      allow create: if signedIn() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.requesterEmail == myEmail() &&
        request.resource.data.status == 'pending' &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.ownerId)/students/$(request.resource.data.studentId));
      allow read, delete: if signedIn() &&
        (request.auth.uid == resource.data.ownerId || request.auth.uid == resource.data.requesterId);
      allow update: if false;
    }

    // ---------------------------------------------------------------------
    // users/{uid}
    //   -> { activeSessionToken, activeSessionUpdatedAt }
    //
    // The account owner's own doc — previously never written directly, only
    // its students subcollection was. Backs single-active-session
    // enforcement: signing in claims a fresh token here, and every other
    // device watching this doc sees its own locally-stored token go stale
    // and signs itself out (src/context/AppContext.jsx). Fields are pinned
    // so this can't become a foothold for arbitrary account-doc storage.
    //
    // delete is scoped to the account owner so that deleting an account
    // (src/pages/Account.jsx -> performDeletion) can take this record with
    // it, instead of leaving the last session token orphaned once the auth
    // user is gone. The doc holds nothing but that token and a timestamp, so
    // an owner deleting their own is harmless: other live sessions read a
    // missing token as "no active claim" (no spurious sign-out) until the
    // next sign-in re-claims.
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['activeSessionToken', 'activeSessionUpdatedAt']) &&
        request.resource.data.activeSessionToken is string &&
        request.resource.data.activeSessionToken.size() < 100 &&
        request.resource.data.activeSessionUpdatedAt is string &&
        request.resource.data.activeSessionUpdatedAt.size() < 40;
      allow delete: if signedIn() && request.auth.uid == uid;

      // -----------------------------------------------------------------
      // users/{uid}/entitlements/{entitlementId} -> e.g. "familyPack" doc:
      // { active, productId, store, environment, transactionId,
      //   purchasedAt, validatedAt }
      //
      // Deliberately a subcollection rather than fields on users/{uid}
      // itself: the doc above is client-writable (session token) under a
      // strict hasOnly() allow-list, and Firestore's `update` rules see the
      // WHOLE resulting document, not just the patched fields — if
      // entitlement lived as a field there, a normal client session-token
      // write would fail hasOnly() the moment an entitlement field also
      // existed on the doc. A separate subcollection sidesteps that
      // entirely rather than special-casing the allow-list.
      //
      // No `create`/`update`/`delete` rule is granted here at all, which
      // means the default (implicit deny, same as the catch-all at the
      // bottom of this file) applies to every client write — the ONLY way
      // a document is ever written here is functions/src/validatePurchase.js
      // via the Admin SDK, which bypasses these rules entirely. That is the
      // whole point: a purchase can't be spoofed by writing this doc
      // directly, because nothing signed in as a normal user is ever
      // allowed to write it, verified receipt or not.
      //
      // Read is scoped to the owner only. A shared co-parent does NOT read
      // this directly — they see the owner's Family Pack status via the
      // `familyPackActive` flag denormalized onto each student document
      // (functions/src/entitlementFanout.js), which they already have read
      // access to via isSharedWithMe(). That keeps this subcollection from
      // needing to open up to arbitrary other accounts.
      // -----------------------------------------------------------------
      match /entitlements/{entitlementId} {
        allow read: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---------------------------------------------------------------------
    // users/{ownerId}/students/{studentId} and their logs
    //
    // Owner has full control; anyone the student is shared with can read the
    // student and read/write its drive logs, but can't edit or delete the
    // student itself. The added ownerId check on writes keeps a student
    // document from claiming an owner other than the account it lives under —
    // the client reads that field to build log paths.
    // ---------------------------------------------------------------------
    match /users/{ownerId}/students/{studentId} {
      allow read: if signedIn() &&
        (request.auth.uid == ownerId ||
         isSharedWithMe(resource.data) ||
         myEmail() in resource.data.get('sharedWithEmails', []));
      allow create, update: if signedIn() &&
        request.auth.uid == ownerId &&
        request.resource.data.ownerId == ownerId;
      // DEV-62: lets a shared recipient pin their own stable uid onto a
      // student they were invited to by email, the first time they sign
      // in with that exact address — see isSharedWithMe() above and the
      // reconciliation logic in src/context/AppContext.jsx's
      // loadFromFirestore. Scoped tightly so this can't become a way to
      // add access rather than merely resolve an invite already extended:
      // the caller's own current sign-in email must already be listed in
      // sharedWithEmails, their uid must not already be in sharedWithUids,
      // and the only change permitted is appending exactly that uid to
      // exactly that field.
      allow update: if signedIn() &&
        myEmail() in resource.data.get('sharedWithEmails', []) &&
        !(request.auth.uid in resource.data.get('sharedWithUids', [])) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedWithUids']) &&
        request.resource.data.sharedWithUids == resource.data.get('sharedWithUids', []).concat([request.auth.uid]);
      allow delete: if signedIn() && request.auth.uid == ownerId;

      // Owner and shared co-parents get full read/write on drive logs.
      match /logs/{logId} {
        allow read, write: if signedIn() &&
          (request.auth.uid == ownerId ||
           isSharedWithMe(get(/databases/$(database)/documents/users/$(ownerId)/students/$(studentId)).data));
      }
    }

    // Inlined (not routed through isSharedWithMe()) because Firestore's
    // list/collection-group query validator can't statically prove a rule
    // matches the query's array-contains filter when the check is hidden
    // inside a function call — it denies the whole query rather than risk
    // it. The direct path-specific rule above doesn't have this constraint
    // (get() requests evaluate fully dynamically), so it can keep using
    // the helper.
    match /{path=**}/students/{studentId} {
      allow read: if signedIn() &&
        (myEmail() in resource.data.get('sharedWithEmails', []) ||
         request.auth.uid in resource.data.get('sharedWithUids', []));
    }

    // ---------------------------------------------------------------------
    // emailToUid/{email} -> { uid }
    //
    // Self-written on every sign-in (src/context/AppContext.jsx), so
    // shareStudent() can resolve a recipient's stable uid immediately when
    // they already have an account, instead of waiting for their first
    // post-share sign-in to self-resolve it (see isSharedWithMe() above).
    // Keyed by the literal lowercased address, same as emailPreferences —
    // no reason to hash it, since get() is scoped to the caller's own
    // current email regardless.
    //
    // A caller may only ever write the document for their OWN current
    // sign-in email, and only their own uid into it, so this can't be used
    // to plant somebody else's uid under an address they don't control.
    // ---------------------------------------------------------------------
    match /emailToUid/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() &&
        email == myEmail() &&
        request.resource.data.keys().hasOnly(['uid']) &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // invitations/{invitationId}
    //
    // Write-only queue drained by scripts/send-invitation-emails.js with the
    // admin SDK, which bypasses these rules. Fields are pinned so a client
    // can't pre-set emailSent or attach extra payload to a queued email.
    // The content of that email is user-controlled by design (owner and
    // student names); it is escaped at render time in
    // src/utils/invitations.js, which is what keeps it from carrying markup.
    //
    // The owner can read and delete their own queued invitations so that
    // deleting a student takes its pending invitations with it, rather than
    // leaving records naming the student and the recipient's address behind.
    // Scoped to resource.data.ownerId, which is also what makes the
    // owner-filtered query the cleanup runs a valid list.
    // ---------------------------------------------------------------------
    match /invitations/{invitationId} {
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerEmail == request.auth.token.email &&
        request.resource.data.email is string &&
        request.resource.data.emailSent == false &&
        request.resource.data.keys().hasOnly([
          'email', 'studentId', 'studentName', 'ownerId', 'ownerName',
          'ownerEmail', 'createdAt', 'emailSent'
        ]);
      allow read, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if false;
    }

    // ---------------------------------------------------------------------
    // receipts/{store}:{transactionId}
    //   -> { uid, store, productId, transactionId, environment, validatedAt }
    //
    // One record per store transaction ever validated, keyed by the
    // store's own transaction id (not a generated one) so a resubmitted or
    // replayed receipt lands on the same document instead of creating a
    // new one. functions/src/validatePurchase.js reads this inside a
    // Firestore transaction before granting entitlement: if the doc
    // already exists under a DIFFERENT uid, that's a receipt being replayed
    // against a second account, and the write is refused.
    //
    // No client access at all, read or write — this collection exists
    // purely as the Admin SDK's own bookkeeping for
    // functions/src/validatePurchase.js and has no reason to ever be read
    // by the app. Falls through to the catch-all deny below in spirit; kept
    // as its own explicit rule so that intent doesn't depend on the
    // catch-all never changing.
    // ---------------------------------------------------------------------
    match /receipts/{receiptId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
