# Loaded automatically by `npm run build:ios` (vite build --mode ios).
# See AUTH WIRING NOTES in src/pages/Login.jsx for the full Apple Sign-In
# checklist this depends on. Kept out of plain `npm run build`, which is
# what .github/workflows/deploy.yml uses for the web app — the web Apple
# Sign-In flow isn't configured (needs a Services ID + Firebase redirect
# setup), so the button must stay hidden there.
VITE_ENABLE_APPLE_SIGNIN=true
